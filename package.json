{
  "name": "n1-digital-plataforma",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev -w @n1/web -- -p 3001\" \"npm run dev -w @n1/api\"",
    "dev:web": "npm run dev -w @n1/web --",
    "build": "npm run build -w @n1/web",
    "start": "npm run start -w @n1/web --",
    "lint": "npm run lint -w @n1/web --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verificar:tokens": "npm run verificar:tokens -w @n1/web",
    "check": "npm run typecheck && npm run lint && npm run verificar:tokens && npm run test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5"
  }
}
