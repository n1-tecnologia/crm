{
  "name": "video-do-financeiro",
  "private": true,
  "description": "Grava a tela real do apps/web contra um servidor de demonstração e monta o vídeo do Guia do Financeiro com Remotion. Fora dos workspaces: o CI não instala nada daqui.",
  "type": "module",
  "scripts": {
