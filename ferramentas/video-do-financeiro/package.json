    "renderizar": "node renderizar.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@supabase/supabase-js": "^2.116.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.532"
  }
}
