# Exemplo de apps/web/.env.local (git-ignored — .gitignore cobre .env*).
#
# As chaves do Supabase (NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY) já estão documentadas em
# apps/web/.env.example; este arquivo acrescenta o endereço do apps/api.

# Onde o navegador encontra o apps/api — pública porque o fetch do store
# roda no cliente (apps/web/src/dados/store.ts).
NEXT_PUBLIC_API_URL=http://localhost:3002

# Mesmo valor, para o lado servidor do Next (Server Components/Actions):
# usada quando definida, para permitir rede interna no deploy — o endereço
# exato ainda depende de onde o apps/api roda (PERS-08/D11).
API_URL=http://localhost:3002
