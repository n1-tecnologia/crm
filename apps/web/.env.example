NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Monitoramento de erros (Sentry, SEG-10). Um DSN por ambiente: Production e
# Preview na Vercel, cada um com o seu. Vazio = nada é enviado e o SDK nem
# inicia (desenvolvimento, testes, build).
# NEXT_PUBLIC_SENTRY_DSN vale para o navegador e é lido em tempo de build;
# SENTRY_DSN vale para o servidor do Next. O DSN identifica o projeto, não é
# senha, mas fica fora do repositório: o valor é do dono (09-19).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
