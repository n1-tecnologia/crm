# Evolution API — modelo do /opt/evolution/evolution.env (D-12, 1.7.5).
# Copiado por preparar-vps-evolution.sh SÓ se o arquivo ainda não existir; o
# script então preenche as duas chaves vazias com `openssl rand -hex 32` e
# troca __DOMINIO__. O arquivo real é modo 600 e nunca vai para o repositório.
#
# A chave de API (AUTHENTICATION_API_KEY) vai para o cofre do CRM na Sessão 4
# (conectar número), nunca para o repositório, nem para o chat, nem para log.
#
# Nomes das variáveis: de fontes de terceiros (a documentação oficial não
# carregou na pesquisa, A11). O dono confere contra a versão da imagem fixada no
# docker-compose.yml no checkpoint de 09-19, antes do primeiro `up`.

# --- servidor ---------------------------------------------------------------
SERVER_URL=https://__DOMINIO__
SERVER_PORT=8080

# --- autenticação (preenchida pelo script; vazia aqui de propósito) ---------
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# --- Postgres próprio (serviço `postgres` do compose) -----------------------
POSTGRES_PASSWORD=
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:${POSTGRES_PASSWORD}@postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_crm

# --- Redis próprio (serviço `redis` do compose) -----------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_LOCAL_ENABLED=false
