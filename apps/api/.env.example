# Conexão direta com o Postgres do Supabase.
#
# Onde achar: Supabase Dashboard > Project Settings > Database >
# Connection string > URI. É a "Session pooler" ou a "Direct connection";
# qualquer uma serve, desde que aceite transação — a Unidade de Trabalho
# depende disso, e por isso a service role key do PostgREST não resolve:
# ela não abre transação nem executa DDL.
#
# Este arquivo é exemplo. O real é apps/api/.env, que o .gitignore cobre.
DATABASE_URL=postgres://postgres.<ref>:<senha>@<host>.pooler.supabase.com:5432/postgres

# Em homologação e produção (Fase 9, D-07) o app NÃO roda como o dono do banco:
# DATABASE_URL é o papel `n1_api` (só DML), pelo pooler compartilhado, em modo
# sessão (porta 5432). No pooler o usuário é `[PAPEL].[REF-DO-PROJETO]` e a senha
# vai com percent-encoding:
#   DATABASE_URL=postgres://n1_api.<ref>:<senha-percent-encoded>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
#
# DATABASE_URL_MIGRACAO é o dono do banco (`postgres.<ref>`): é a conexão de
# `npm run migrar`, de `npm run banco:conceder` e do backup — tudo que faz DDL.
# As duas linhas mudam JUNTAS no api.env: trocar só DATABASE_URL para `n1_api`
# faz o próximo `migrar` falhar no DDL e travar o deploy.
# Vazia em desenvolvimento: cai em DATABASE_URL.
DATABASE_URL_MIGRACAO=

# Porta e host do processo Fastify.
PORT=3002
HOST=127.0.0.1

# Origem exata do apps/web — allowlist do CORS, sem barra final.
WEB_ORIGIN=http://localhost:3001

# O único Espaço de Trabalho da Fase 1; o hook de autenticação resolve o
# Membro dentro dele.
WORKSPACE_ID=ws_n1

# Nível de log do Fastify (trace|debug|info|warn|error|fatal|silent). Lido por
# `opcoesDoLogger` (observabilidade/log.ts), que também censura tokens e
# mascara o segredo de link das rotas públicas.
LOG_LEVEL=info

# Quem pode dizer o IP de quem chamou pelo `X-Forwarded-For` (o `trustProxy` do
# Fastify): endereços ou faixas separados por vírgula, ou `loopback`.
# - Vazio em desenvolvimento: ninguém é confiável, vale o IP da conexão.
# - `loopback` atrás do nginx (o `n1-crm-api.service` já fixa este valor).
# Sem ele, atrás do nginx todo `request.ip` é 127.0.0.1 e o limite de taxa por
# IP vira um balde só para a internet inteira.
TRUST_PROXY=

# Projeto Supabase da plataforma (epomplsskqpluxuujpxl) — usado pelo hook de
# autenticação (getClaims) e pelos scripts de usuário/seed.
#
# Onde achar: Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# A secret key (sb_secret_…), nunca a publishable — este processo verifica
# token e chama a Admin API, o navegador não.
SUPABASE_SECRET_KEY=

# Token pessoal do ClickUp — só para apps/api/src/importacao/clickup/
# (npm run exportar:clickup / npm run clickup:usuarios), Fase 0/PREP-02, D-01.
#
# Onde achar: ClickUp > avatar > Settings > Apps > API Token. É o mesmo
# token que o automation/ do financeiro-tria já usa na VPS (formato pk_...).
#
# Lido por carregarEnv(), nunca logado.
CLICKUP_API_TOKEN=

# ── Webhook da Meta — WhatsApp oficial (GET/POST /webhooks/meta/whatsapp) ──
#
# META_WEBHOOK_VERIFY_TOKEN: um texto QUE VOCÊ INVENTA (ex.: `openssl rand -hex 24`)
# e cola no painel do app da Meta, no campo "Verify token", ao cadastrar a URL
# do webhook. Sem ele o GET de verificação responde 403 e a Meta não aceita a URL.
META_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET: o "App secret" do app (developers.facebook.com > seu app >
# App settings > Basic). Com ele, o POST só passa com a assinatura
# X-Hub-Signature-256 válida; sem ele, aceita sem conferir e avisa no log.
META_APP_SECRET=

# ── Webhook da Meta — Instagram (GET/POST /webhooks/meta/instagram) ──
#
# O verify token é o MESMO do WhatsApp (META_WEBHOOK_VERIFY_TOKEN, acima): cole o
# mesmo texto no campo "Verify token" do painel do Instagram.
# INSTAGRAM_APP_SECRET: a "Chave secreta do app do Instagram" (developers.facebook.com
# > seu app > Casos de uso > API do Instagram > Configuração da API com login do
# Instagram). É DIFERENTE do META_APP_SECRET. O POST aceita a assinatura de qualquer
# um dos dois e o log diz qual bateu (campo `segredo`); quando se confirmar qual a
# Meta usa, o outro deixa de ser necessário. Sem nenhum dos dois, aceita sem conferir
# e avisa no log.
INSTAGRAM_APP_SECRET=

# ── Fase 2 — credenciais de serviço (D-15) ──────────────────────────────
#
# Nome lógico de quem emite/administra as credenciais de serviço do
# automation/ (plataforma.service_credentials, apps/api/src/servicos/
# credencial.cli.ts). O token em si NUNCA vai para este arquivo — ele existe
# só uma vez, na saída de `npm run credencial -w @n1/api -- emitir/
# rotacionar`, e o banco guarda apenas o hash dele.
PLATAFORMA_SERVICE_TOKEN_ISSUER=crm-n1

# ── Fase 2 — Storage de anexos (nota fiscal/boleto/comprovante, D-04) ───
#
# Bucket privado do Supabase da plataforma onde os anexos vivem — download
# só por URL assinada, nunca pública (apps/api/src/servicos/
# storage-uploads.ts). Já pode existir no ambiente: não duplicar.
SUPABASE_STORAGE_BUCKET=solicitacoes
# Não há uma quarta variável: o Storage usa o mesmo cliente de SUPABASE_URL +
# SUPABASE_SECRET_KEY (apps/api/src/autenticacao/verificar-token.ts,
# `clienteAdmin()`). Para conferir o bucket do ambiente sem subir arquivo:
# `npm run storage:conferir -w @n1/api`.
# Duração da sessão de upload (ticket assinado de envio), em segundos.
UPLOAD_TTL_SEGUNDOS=7200
# Teto de tamanho por arquivo, em bytes (25 MiB).
UPLOAD_MAX_BYTES=26214400
# Teto de arquivos por sessão de upload.
UPLOAD_MAX_ARQUIVOS=10
# Teto de bytes lidos para conferir a assinatura de arquivo (magic bytes) —
# nunca o arquivo inteiro, só o suficiente para reconhecer o tipo.
UPLOAD_SHA256_MAX_BYTES=1048576
# Duração da URL assinada de download, em segundos — cada leitura gera uma
# URL nova; nenhuma fica guardada além deste prazo.
DOWNLOAD_TTL_SEGUNDOS=300

# ── Fase 2 — outbox transacional (D-18/D-19) ────────────────────────────
#
# Liga o worker que entrega plataforma.integration_outbox ao automation/
# (apps/api/src/persistencia/outbox-worker.ts, apps/api/src/index.ts).
# "false" no ambiente local — nenhuma entrega sai sem automation/ escutando.
OUTBOX_WORKER_ATIVO=false
# Identificador desta instância do worker (default: apps-api-<pid> se vazio)
# — aparece em locked_by, para saber qual processo tem a lease de uma linha.
OUTBOX_WORKER_ID=
# URL do endpoint do automation/ que recebe os eventos.
OUTBOX_DESTINO_URL=
# Credencial de serviço apresentada ao automation/ na entrega — o mesmo
# token que `npm run credencial` emite, nunca um valor à mão.
OUTBOX_TOKEN=
# Tentativas antes de marcar 'failed' definitivamente (backoff com jitter,
# RESEARCH.md "Outbox transacional").
OUTBOX_MAX_TENTATIVAS=10

# ── Fase 3 — motor de Automações (AUTO-01, Plan 03-08) ──────────────────
#
# Liga o scheduler que garante ao menos uma chamada de
# runScheduledAutomations por (Espaço, Lista, dia civil)
# (apps/api/src/automacoes/scheduler-worker.ts, apps/api/src/index.ts).
# "false" no ambiente local — nenhuma Automação de agenda dispara sem isto.
AUTOMACOES_WORKER_ATIVO=false
# Identificador desta instância do worker (default: apps-api-agenda-<pid>
# se vazio) — aparece em locked_by, para saber qual processo tem a lease
# de uma linha de plataforma.automacao_agenda.
AUTOMACOES_WORKER_ID=
# Intervalo entre ciclos do scheduler, em ms (default 3600000 = 1h).
AUTOMACOES_INTERVALO_MS=
# Quantos dias de catch-up semear no máximo por (Espaço, Lista) (default 7).
AUTOMACOES_JANELA_DIAS=
# Só o PREFERIDO (Fase 10): vazio (padrão) = o Membro do Papel "Agente do
# pipeline" (D-15). Em cada Lista, se o preferido não a administra, o relógio
# escolhe um Proprietário ou Administrador que a administra (e assina a
# Atividade em nome dele). Em produção fica VAZIO; só preencha em teste manual.
AUTOMACOES_ATOR_MEMBER_ID=
# "false" desliga o gate da primeira volta em ensaio (Task 2, D3-03). Desde a
# Fase 10 o ensaio só vale para Listas com Automação por vencimento; a Lista
# só com Recorrência por calendário já nasce direto. Padrão ligado (qualquer
# valor != "false").
AUTOMACOES_ENSAIO_PRIMEIRA_VOLTA=true

# ── Fase 2 — fallback de comentário (D-10) ───────────────────────────────
#
# Data (ISO, ex. 2026-12-31) até quando o fallback de 90 dias de D-10 fica
# ativo — calculada e registrada no deploy, não um valor de exemplo real.
FALLBACK_COMENTARIO_ATE=

# ── Fase 3 — a ponte do Agente de lançamento (PAG-03/PAG-04, Plan 03-11) ─
#
# Liga a ponte HTTP que resolve o de-para do lançamento contra o `automation/`
# (apps/api/src/automacoes/invocar-agente.ts, apps/api/src/index.ts) e o
# injeta no motor de Automações pela costura que o scheduler (03-08) expõe.
# "false" no ambiente local — nenhuma requisição ao Agente sai sem isto.
AGENTE_CONTAS_A_PAGAR_ATIVO=false
# Origem HTTP do automation/ em produção, sem barra final — a mesma que
# OUTBOX_DESTINO_URL já usa.
AGENTE_CONTAS_A_PAGAR_URL=
# Padrão "ensaio": o Agente calcula e registra o que lançaria, sem escrever
# no Omie — só o literal "lancar" liga a caneta (D3-03), e mesmo ele exige
# PLATAFORMA_LANCAMENTO_TOKEN e esta URL presentes. Qualquer outro valor
# (ausente, vazio, erro de digitação) é tratado como "ensaio", com aviso.
AGENTE_CONTAS_A_PAGAR_MODO=ensaio
# O Espaço de Trabalho e a Lista de Contas a pagar que a ponte observa — ela
# é específica por desenho, ao contrário do agendador (03-08), que é genérico.
AGENTE_CONTAS_A_PAGAR_ESPACO_ID=
AGENTE_CONTAS_A_PAGAR_LISTA_ID=
# Intervalo entre aquecimentos do cache de de-para, em ms (default 900000 =
# 15min) — mais curto que o do agendador (AUTOMACOES_INTERVALO_MS), de
# propósito, para o cache estar quente quando o agendador bater.
AGENTE_CONTAS_A_PAGAR_INTERVALO_MS=
# JSON `{"<valor do Campo Empresa>": "<CNPJ formatado>"}` com o CNPJ real de
# cada Empresa PAGADORA (nunca do fornecedor) — ex.:
# {"Tria Company":"11.222.333/0001-81","Konq Intermediações":"44.555.666/0001-72"}
# Substitui a tabela fictícia que packages/dominio/src/operations/financeiro.ts
# tinha (PAG-04); sem esta variável, ou com a Empresa ausente dela, o texto de
# A5 diz "da Empresa <nome>" e nenhum número inventado.
AGENTE_CONTAS_A_PAGAR_CNPJ_POR_EMPRESA=
# A credencial de serviço que 03-07 emitiu no .env do automation/ — o MESMO
# valor, nunca um segundo gerado aqui (openssl rand -hex 32, quem opera a
# VPS). Distinta de PLATAFORMA_WEBHOOK_TOKEN (plataforma → automation/, os
# webhooks do contrato de Solicitação) e de PLATAFORMA_SERVICE_TOKEN
# (automation/ → plataforma, os 7 métodos do contrato de Solicitação), D-15.
PLATAFORMA_LANCAMENTO_TOKEN=

# Leituras do Financeiro (Fase 4 -- D4-01/D4-02)
# FINANCEIRO_LEITURAS_URL: origem do automation/, sem barra final. Quando ausente,
# as rotas GET /financeiro/* respondem 503 com mensagem fixa e a tela mostra o
# estado de falha (D4-15) -- o apps/api nunca deixa de subir por causa disto.
FINANCEIRO_LEITURAS_URL=
# PLATAFORMA_LEITURA_TOKEN: credencial de servico SO DE LEITURA.
# (1) precisa ser o MESMO valor escrito no .env do automation/;
# (2) e deliberadamente DIFERENTE de PLATAFORMA_LANCAMENTO_TOKEN (D4-02,
# escopo minimo de D-15) -- o token que le o Dashboard nao pode ser o token
# que lanca no Omie.
PLATAFORMA_LEITURA_TOKEN=

# ─── Escritas do Financeiro e Agente do pipeline (auditoria 2026-09-28) ─────
# PLATAFORMA_LANCAMENTO_TOKEN também autentica os POST de /financeiro/* que a
# API repassa ao automation/ (/v1/leituras: alíquotas, importar/remover plano
# de contas, executar workflow, repetir passo, cancelar execução). Sem ele,
# essas escritas respondem 503 — mesmo com a ponte do Agente desligada.
# PLATAFORMA_LEITURA_TOKEN continua só nas leituras (GET).
#
# AUTOMACOES_ATOR_MEMBER_ID: deixe VAZIO depois de rodar
# `npm run solicitacoes:configurar -w @n1/api -- --apply` (cria o Membro de
# serviço "Agente do pipeline", que assina o que o agendador e a ponte gravam).
# Só use para teste manual.
#
# AUTOMACOES_ESPACO_ID / AUTOMACOES_LISTA_ID: estreitam o agendador a um Espaço
# e a uma Lista (ex.: só Contas a pagar). Vazios: todos. ATENÇÃO (Fase 10):
# com AUTOMACOES_LISTA_ID preenchido o relógio só visita aquela Lista — a
# Recorrência por calendário das outras Listas PARA de ser gerada.
AUTOMACOES_ESPACO_ID=
AUTOMACOES_LISTA_ID=

# ── Ponte do Agente de lançamento — Fase 6 (Plan 06-03) ──────────────────────
# AGENTE_CONTAS_A_PAGAR_MODO agora tem TRÊS valores (D6-11), só por literal exato:
#   ensaio      (padrão) só /resolver e log do que publicaria/lançaria; nada gravado.
#   conferencia publica o Resumo para conferência, lê o fio e revisa; NUNCA chama /lancar.
#   lancar      tudo: Resumo, conferência e /lancar com a Conferência aprovada.
# Qualquer outro valor cai em ensaio com aviso. (A variável já está declarada acima.)
#
# D6-01 — quando o Resumo aparece: para-pagar (padrão; assim que a conta fica
# completa, como no ClickUp) | em-lancamento-omie (só ao entrar nesse Status).
AGENTE_CONTAS_A_PAGAR_RESUMO_A_PARTIR_DE=para-pagar
# D6-02 — "ok" de um revisor no fio do Resumo vale como conferência: true (padrão)
# | false (só o clique confere; o fio continua pedindo ajuste).
AGENTE_CONTAS_A_PAGAR_CONFERENCIA_POR_COMENTARIO=true
# D6-04 — conta com "Integração manual" = Manual: nao-encosta (padrão; sem Resumo,
# sem /lancar) | sem-conferencia (Resumo com a Conferência dispensada e lança).
AGENTE_CONTAS_A_PAGAR_INTEGRACAO_MANUAL=nao-encosta
# G2 — SÓ AMBIENTE DE TESTE: os dois momentos só olham contas cujo título contém
# este texto (exato, maiúsculas contam), ex.: TESTE AUTOMATIZADO. Produção: vazio.
AGENTE_CONTAS_A_PAGAR_SO_TITULOS_COM=
# G3 — SÓ AMBIENTE DE TESTE: id do Membro que toda Menção da ponte avisa no lugar
# do Financeiro (Resumo, aprovador da Conferência, falha, avisos). Precisa ser
# Membro ativo; senão vale a regra de sempre, com aviso no log. Produção: vazio.
AGENTE_CONTAS_A_PAGAR_AVISAR_ID=
# 06-13 (crm:WR-01): AGENTE_CONTAS_A_PAGAR_AVISAR_ID exige AGENTE_CONTAS_A_PAGAR_SO_TITULOS_COM (sozinha, a API não sobe); se o id não for Membro ativo, a ponte não age e avisa AVISAR_ID_INVALIDO a cada ciclo.

# ── Fase 9 — cofre de credenciais (SEG-05, D-17) ─────────────────────────
#
# A chave que cifra, com AES-256-GCM, os segredos de provedor (token da
# Evolution, da Meta, e-mail) guardados em plataforma.credenciais. Fica FORA do
# banco: quem levar uma cópia do banco ou do backup leva só texto cifrado.
# 32 bytes em base64. Gere uma com:  openssl rand -base64 32
# Cada ambiente (local, homologação, produção) tem a SUA. Guarde uma cópia fora
# da VPS, com o dono: perder esta chave perde as credenciais gravadas.
# Nunca coloque o valor real neste arquivo de exemplo, no repositório ou em log.
COFRE_CHAVE=
# Versão da chave acima (inteiro >= 1). Fica gravada junto de cada credencial.
COFRE_CHAVE_VERSAO=1
# SÓ durante uma troca de chave: a chave antiga e a versão dela, para ler as
# credenciais ainda cifradas com ela. Procedimento em src/servicos/CONTEXT.md.
# COFRE_CHAVE_ANTERIOR=
# COFRE_CHAVE_ANTERIOR_VERSAO=

# ── Fase 9 — monitoramento de erros (SEG-10, D-13) ───────────────────────
#
# SENTRY_DSN: o DSN do projeto "api" no Sentry. UM DSN POR AMBIENTE (homologação
# e produção têm projetos separados) e só no api.env da VPS — nunca neste
# arquivo, no repositório ou em log. Vazio (desenvolvimento e testes): o SDK nem
# é iniciado e nada sai da máquina. O alerta por e-mail é regra configurada no
# painel do Sentry, não código.
SENTRY_DSN=
# `producao` | `homologacao` | vazio em desenvolvimento (vira "desenvolvimento").
SENTRY_AMBIENTE=
# Liga GET /diagnostico/erro-de-prova, a rota que lança de propósito para provar o
# alerta do Sentry. SÓ em homologação e SÓ durante a prova (09-19): nunca em
# produção. A rota exige sessão e sai do código em 09-22. Vazio = a rota não existe.
ERRO_DE_PROVA_ATIVO=
