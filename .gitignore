node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...exceto os exemplos: só placeholder, servem de documentação para quem clona.
!.env.example
!.env.local.example

# exportação do ClickUp (Fase 0, PREP-02/D-02): dados pessoais e financeiros fora do git (LGPD).
# O manifesto (apps/api/exportacoes/MANIFESTO.*) fica fora deste padrão de propósito e é versionado.
apps/api/exportacoes/clickup/

# relatório do Ensaio do Agente (Plan 03-14, D3-03): o agregado (RELATORIO.md/.json)
# entra no git — só contagens e vocabulário de veredito (T-3-65). O detalhe por
# conta (taskId + as duas triplas) fica fora, no mesmo padrão de LGPD acima.
apps/api/exportacoes/ensaio-do-agente/*/conferencia-detalhada.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sistema
.DS_Store
Thumbs.db
*.log

# o manual de marca (PDF de 21 MB) fica fora do repositório
MANUAL DE MARCA - N1 DIGITAL.pdf

# monorepo: build e tipos por workspace
apps/*/.next/
apps/*/out/
apps/*/next-env.d.ts

# playwright (Plan 02-01)
playwright-report/
test-results/
/apps/web/.playwright/
